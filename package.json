{
  "name": "ai-full-stack-knowledge-base",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "license": "ISC",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=20 <23"
  },
  "devDependencies": {
    "@algolia/client-search": "5.56.0",
    "@lucide/vue": "^1.29.0",
    "@playwright/test": "1.55.0",
    "@types/node": "^22.10.2",
    "debug": "^4.4.3",
    "gray-matter": "^4.0.3",
    "lighthouse": "12.8.2",
    "mermaid": "11.12.2",
    "onnxruntime-web": "1.27.0",
    "search-insights": "2.17.3",
    "tsx": "^4.19.2",
    "type-fest": "^4.41.0",
    "typescript": "^5.7.2",
    "vitepress": "1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0",
    "yarn": "1.22.22"
  },
  "scripts": {
    "dev": "vitepress --port 9999",
    "build": "yarn content:check && vitepress build",
    "preview": "vitepress preview --port 4173",
    "typecheck": "vue-tsc --noEmit",
    "content:check": "tsx scripts/check-content.ts",
    "content:quality": "tsx scripts/check-content-quality.ts",
    "ai-agent:check": "tsx scripts/check-ai-agent-content.ts",
    "ai-agent:examples": "PYTHONPATH=examples/ai-agent python3 -m unittest discover -s examples/ai-agent/tests -p 'test_*.py'",
    "backend:check": "tsx scripts/check-backend-content.ts",
    "devops:check": "tsx scripts/check-ai-infra-content.ts",
    "onnx:check": "node scripts/check-onnx-resources.mjs",
    "build:check": "tsx scripts/check-build.ts",
    "privacy:check": "node scripts/check-privacy.mjs",
    "visual:check": "tsx scripts/visual-smoke.mjs",
    "lighthouse:check": "yarn build && node scripts/lighthouse-check.mjs",
    "verify": "yarn content:check && yarn content:quality && yarn ai-agent:check && yarn ai-agent:examples && yarn backend:check && yarn devops:check && yarn onnx:check && yarn privacy:check && yarn typecheck && vitepress build && yarn build:check"
  }
}
