meta {
  name: stream task events
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/tasks/{{taskId}}/events
  body: none
  auth: inherit
}

headers {
  Accept: text/event-stream
  Last-Event-ID: {{lastEventId}}
}

vars:secret {
  taskId: "40000000-0000-4000-8000-000000000001"
  lastEventId: "1"
}

tests {
  test("returns an SSE response", function() {
    expect(res.status).to.be.oneOf([200, 404])
    if (res.status === 200) expect(res.headers["content-type"]).to.contain("text/event-stream")
  })
}
