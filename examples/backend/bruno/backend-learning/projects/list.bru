meta {
  name: list projects
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/projects?limit=50
  body: none
  auth: inherit
}

tests {
  test("returns cursor page", function() {
    expect(res.status).to.equal(200)
    expect(res.body.items).to.be.an("array")
    expect(res.body).to.have.property("nextCursor")
  })
}
